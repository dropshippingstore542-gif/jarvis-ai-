# ── AI Provider ──────────────────────────────────────────────────────────
# One of: anthropic | openai | local
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_API_KEY=

# Base URL override, e.g. for AI_PROVIDER=local pointing at an OpenAI-
# compatible endpoint such as Ollama or LM Studio.
AI_BASE_URL=

# ── Database ─────────────────────────────────────────────────────────────
# SQLite file path (local-first, no external DB server required).
DATABASE_URL=./data/jarvis.sqlite

# ── Filesystem tool sandbox ──────────────────────────────────────────────
# All filesystem.* tool calls are jailed to this directory. Required.
JARVIS_WORKSPACE_DIR=./workspace

# ── Web search tool ──────────────────────────────────────────────────────
# One of: none | brave | serpapi. Leave WEB_SEARCH_PROVIDER=none and the
# web.search tool will report itself as unconfigured rather than fabricate
# results.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# ── Voice (interfaces only — see ARCHITECTURE.md, not implemented yet) ───
TTS_PROVIDER=none
STT_PROVIDER=none
WAKE_WORD=JARVIS

# ── Proactive behavior ───────────────────────────────────────────────────
# One of: off | low | normal | high. No automation executor exists yet
# (see ARCHITECTURE.md) — this is stored/exposed in settings for when it does.
PROACTIVE_MODE=off

# ── Server ───────────────────────────────────────────────────────────────
PORT=4317
HOST=127.0.0.1
# Local single-user session token. Generate any random string; required to
# call the API. Never commit a real value.
API_AUTH_TOKEN=

LOG_LEVEL=info
