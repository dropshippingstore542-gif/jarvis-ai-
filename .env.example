# ── AI Provider ──────────────────────────────────────────────────────────
# One of: anthropic | openai | local
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_API_KEY=

# Base URL override, e.g. for AI_PROVIDER=local pointing at an OpenAI-
# compatible endpoint such as Ollama or LM Studio.
AI_BASE_URL=

# ── Database ─────────────────────────────────────────────────────────────
# SQLite file path (local-first, no external DB server required).
DATABASE_URL=./data/jarvis.sqlite

# ── Filesystem tool sandbox ──────────────────────────────────────────────
# All filesystem.* tool calls are jailed to this directory. Required.
JARVIS_WORKSPACE_DIR=./workspace

# ── Web search tool ──────────────────────────────────────────────────────
# One of: none | brave | serpapi. Leave WEB_SEARCH_PROVIDER=none and the
# web.search tool will report itself as unconfigured rather than fabricate
# results.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# ── Browser automation (browser.* tools) ──────────────────────────────────
# SSRF guard: by default the assistant cannot navigate to loopback, private,
# or link-local addresses (including the 169.254.169.254 cloud metadata
# endpoint) — see SECURITY.md. Only set true if you deliberately want it
# able to reach your internal network.
JARVIS_BROWSER_ALLOW_PRIVATE_NETWORKS=false

# ── Voice (push-to-talk — see ARCHITECTURE.md for what this does and doesn't cover) ──
# One of: none | openai. Real speech-to-text (Whisper) / text-to-speech when
# set to openai + VOICE_API_KEY. Push-to-talk in the web UI needs both a mic
# (STT_PROVIDER) to send voice messages and, optionally, TTS_PROVIDER for a
# spoken reply — text-only replies work fine with STT alone.
TTS_PROVIDER=none
STT_PROVIDER=none
VOICE_API_KEY=
# Wake word is stored/surfaced but there is no continuous mic-listening loop
# yet — every voice interaction today is push-to-talk, not "always listening."
WAKE_WORD=JARVIS

# ── Email (email.send tool — HIGH RISK, requires approval every call) ────
# One of: none | smtp. Real SMTP delivery via nodemailer; works with a
# Gmail/Outlook app password or any SMTP server.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Calendar ──────────────────────────────────────────────────────────────
# No configuration needed — calendar.create_event stores events locally in
# SQLite. Subscribe to GET /api/calendar.ics from any real calendar app to
# see them there too (the Settings panel shows the exact URL, including the
# ?token= query param automatically appended when API_AUTH_TOKEN is set).

# ── Proactive behavior ───────────────────────────────────────────────────
# One of: off | low | normal | high. Consumed by the automation engine's
# scheduler — see ARCHITECTURE.md. Automations run regardless; this only
# governs how noisy in-app notifications are (not yet surfaced beyond the
# Automations panel's run history).
PROACTIVE_MODE=off

# ── Server ───────────────────────────────────────────────────────────────
PORT=4317
HOST=127.0.0.1
# Local single-user session token. Generate any random string; required to
# call the API. Never commit a real value.
API_AUTH_TOKEN=

LOG_LEVEL=info
