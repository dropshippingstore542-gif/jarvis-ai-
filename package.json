{
  "name": "jarvis-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Private, local-first, modular JARVIS-style personal AI assistant",
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@jarvis/server & npm run dev --workspace=@jarvis/web",
    "dev:server": "npm run dev --workspace=@jarvis/server",
    "dev:web": "npm run dev --workspace=@jarvis/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
